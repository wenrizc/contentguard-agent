# Required for real DeepSeek runs; leave empty for offline tests.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# V1 uses the local mock moderator. No Sightengine key is needed.
MODERATION_PROVIDER=mock

# Optional future integration; not read by V1.
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
